[Unit]
Description=Chiara Speech2Text Model Server
After=network.target

# Template: replace <user> with the account that should run the service, and
# /path/to/chiara-speech2text with the directory the project is checked out into.

[Service]
Type=simple
User=<user>
Group=<user>

# Set the working directory to where the script is located
WorkingDirectory=/path/to/chiara-speech2text/model-server

# Use the Python executable from your virtual environment to run the script
ExecStart=/path/to/chiara-speech2text/.stt/bin/python /path/to/chiara-speech2text/model-server/model-server.py --env-file /path/to/chiara-speech2text_envs/.env

# Restart the service automatically if it crashes
Restart=always
# Wait 5 seconds before restarting
RestartSec=5

# Output logging (viewable via journalctl)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target