# Instructions:
# This file should contain all necessary environment variables for the chiara-speech2text modules, inlcuding
# frontend, Firebase config paths, transcription server URLs, EmailJS config, default notification emails, Google Cloud configuration, Hugging Face API token.
# See docs/readme-technical.md for instructions on how to setup this file.
# - No spaces after the equal sign
# - No quotes for values

# Firebase Client Config
# These variables are used for client-side access to Firebase services.
FIREBASE_CLIENT_API_KEY=
FIREBASE_CLIENT_AUTH_DOMAIN=
FIREBASE_CLIENT_PROJECT_ID=
FIREBASE_CLIENT_STORAGE_BUCKET=
FIREBASE_CLIENT_MESSAGING_SENDER_ID=
FIREBASE_CLIENT_APP_ID=

# Firebase Admin Config
# These variables allow server-side access to Firebase services (e.g. read, write operations).
FIREBASE_ADMIN_TYPE=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_PRIVATE_KEY_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_CLIENT_ID=
FIREBASE_ADMIN_AUTH_URI=
FIREBASE_ADMIN_TOKEN_URI=
FIREBASE_ADMIN_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_ADMIN_CLIENT_X509_CERT_URL=
FIREBASE_ADMIN_UNIVERSE_DOMAIN=

# Frontend config
# These variables configure the frontend application, including host, port, source, and Firebase bucket.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5000
FRONTEND_SOURCE=
FRONTEND_FIREBASE_BUCKET=${FIREBASE_CLIENT_STORAGE_BUCKET}
#FRONTEND_FIREBASE_CREDENTIALS=/absolute/path/to/service-account.json
#FRONTEND_SOURCE=local
#FRONTEND_LOCAL_ROOT=/home/lucar/Development/chiara-speech2text_data/test

# Model server config
# These variables configure the model server, including host, port, model paths, and Firebase bucket.
MODEL_SERVER_HOST=127.0.0.1
MODEL_SERVER_PORT=8000
MODEL_SERVER_FIREBASE_BUCKET=${FIREBASE_CLIENT_STORAGE_BUCKET}
MODEL_SERVER_WHISPER_MODEL_PATH=
MODEL_SERVER_LLM_MODEL=

# Hugging Face
# These variables are used for accessing private Hugging Face APIs and models.
HF_USER=
HF_TOKEN=

# Google Cloud configuration
# These variables configure Google Cloud settings, including project ID, user account, location, repository name, page name, and description.
# These are used for deploying and managing Docker images in Google Cloud.
GCLOUD_PROJECT_ID=
GCLOUD_USER_ACCOUNT=
GCLOUD_LOCATION=
GCLOUD_REPO_NAME=
GCLOUD_PAGE_NAME=${GCLOUD_REPO_NAME}
GCLOUD_DESCRIPTION="${GCLOUD_REPO_NAME}_DockerRepo"

# Model trainer config
TRAINER_FIREBASE_BUCKET=${FIREBASE_CLIENT_STORAGE_BUCKET}