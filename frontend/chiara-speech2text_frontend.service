[Unit]
Description=Chiara Speech2Text Frontend Server
After=network.target

# Template: replace <user> with the account that should run the service, and
# /path/to/chiara-speech2text with the directory the project is checked out into.

[Service]
Type=simple
User=<user>
Group=<user>

# Set the working directory to where the script is located
WorkingDirectory=/path/to/chiara-speech2text/frontend

# 2) Create Tailscale Serve config in background (run as root via systemd '+' prefix)
# this allows to forward to a HTTPS port (required for microphone access)
ExecStartPre=+/usr/bin/tailscale serve --bg --https=443 http://127.0.0.1:5000

# 3) Verify Tailscale Serve status (also run as root)
ExecStartPre=+/usr/bin/tailscale serve status

# 1) Start app locally on loopback only
ExecStart=/path/to/chiara-speech2text/.stt/bin/python /path/to/chiara-speech2text/frontend/frontend.py --env-file /path/to/chiara-speech2text_envs/.env

# Restart the service automatically if it crashes
Restart=always
# Wait 5 seconds before restarting
RestartSec=5

# Output logging (viewable via journalctl)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
